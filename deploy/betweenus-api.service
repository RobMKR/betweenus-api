[Unit]
Description=BetweenUs authenticated API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=betweenus
Group=betweenus
WorkingDirectory=/opt/betweenus/current
EnvironmentFile=/etc/betweenus/api.env
Environment=NODE_ENV=production DEMO_MODE=false
ExecStart=/opt/betweenus/node/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=384M
TasksMax=64
LogNamespace=betweenus
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
